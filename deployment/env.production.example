# ==============================================================================
# Cambridge Education System - Production Environment Variables (.env)
# Domain: cambridgeeducation.uk.com | Backend Port: 4000
# ==============================================================================

# Server & Runtime
NODE_ENV=production
PORT=4000
APP_BASE_URL=https://api.cambridgeeducation.uk.com

# CORS Allowed Origins
ALLOWED_ORIGINS=https://principle.cambridgeeducation.uk.com,https://faculty.cambridgeeducation.uk.com,https://student.cambridgeeducation.uk.com,https://parent.cambridgeeducation.uk.com,https://parents.cambridgeeducation.uk.com,https://api.cambridgeeducation.uk.com

# Database (MySQL 8 on VPS)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=school_db
DB_USER=ces_user
DB_PASSWORD=ChangeThisToAStrongSecretPassword123!
DB_SSL=false

# Authentication & Cryptographic Tokens
JWT_ACCESS_SECRET=school_jwt_production_access_secret_super_secure_key_32_chars!
ACCESS_TTL_MIN=1440
REFRESH_IDLE_DAYS=30
REFRESH_ABS_DAYS=90
CSRF_SECRET=school_csrf_production_hmac_secret_super_secure_key_32_chars!

# Cookies
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Redis & BullMQ (Local Redis Server on VPS)
REDIS_CACHE_URL=redis://127.0.0.1:6379/0
REDIS_QUEUE_URL=redis://127.0.0.1:6379/1

# School Configuration
SCHOOL_TIMEZONE=Asia/Karachi
FEE_SCHEDULER_ENABLED=true

# Zoom Server-to-Server OAuth Integration
ZOOM_ACCOUNT_ID=5AqiKI-1ScuOXxGmnzoXoA
ZOOM_CLIENT_ID=d0MFfNdnQHCfTGRunQYe4g
ZOOM_CLIENT_SECRET=i6Te7ciQmRkTiVUpdwwR6cBKb1LYXSIX
ZOOM_WEBHOOK_SECRET_TOKEN=optional_webhook_verification_token
ZOOM_WEBHOOK_TOLERANCE_SEC=300
ZOOM_RECONCILE_ENABLED=true

# Brevo / SMTP Email Dispatch Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=b24400001@smtp-brevo.com
SMTP_PASS=xsmtpsib-5080e6663158598f0b3abe5bcb80eaadb49ff78412c78df689ec0ad1230d2b15-Pm30r1ZDqdnYjgGs
SMTP_FROM="EduPulse School Management <mubinasaleem24@gmail.com>"

# Subdomain Portal URLs for credential links in emails
TEACHER_PORTAL_URL=https://faculty.cambridgeeducation.uk.com
STUDENT_PORTAL_URL=https://student.cambridgeeducation.uk.com
PARENT_PORTAL_URL=https://parent.cambridgeeducation.uk.com
