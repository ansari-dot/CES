# Server & Runtime
NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:5173,http://localhost:5174

# Database (MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=school_db
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# Authentication & Tokens
JWT_ACCESS_SECRET=change_this_to_a_secure_random_string_at_least_32_chars_long
ACCESS_TTL_MIN=1440
REFRESH_IDLE_DAYS=30
REFRESH_ABS_DAYS=90
CSRF_SECRET=change_this_to_another_secure_hmac_key_for_csrf_token_signing

# Cookies (set to true in production over HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Redis & BullMQ
REDIS_CACHE_URL=redis://127.0.0.1:6379/0
REDIS_QUEUE_URL=redis://127.0.0.1:6379/1

# School Configuration
SCHOOL_TIMEZONE=Asia/Karachi

# Brevo / SMTP Mail Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_account_email@example.com
SMTP_PASS=your_brevo_smtp_key_here
SMTP_FROM="Cambridge Education System <no-reply@cambridgeeducation.uk.com>"
TEACHER_PORTAL_URL=http://localhost:3001
STUDENT_PORTAL_URL=http://localhost:3000
PARENT_PORTAL_URL=http://localhost:3003

# Fee lifecycle (monthly invoices due on the 5th, grace to the 10th, restriction from the 11th in SCHOOL_TIMEZONE)
FEE_SCHEDULER_ENABLED=true
# Official Principal WhatsApp number shown to fee-restricted students (international digits, e.g. 923001234567). Leave unset to hide the link.
# PRINCIPAL_WHATSAPP_NUMBER=
# IP geolocation endpoint for student timezone detection ({ip} is substituted). Check the provider's terms for commercial use.
GEO_LOOKUP_URL=http://ip-api.com/json/{ip}?fields=status,timezone
