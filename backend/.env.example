# Server & Runtime
NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Database (MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=school_db
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# Authentication & Tokens
JWT_ACCESS_SECRET=change_this_to_a_secure_random_string_at_least_32_chars_long
ACCESS_TTL_MIN=15
REFRESH_IDLE_DAYS=7
REFRESH_ABS_DAYS=30
CSRF_SECRET=change_this_to_another_secure_hmac_key_for_csrf_token_signing

# Cookies (set to true in production over HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Redis & BullMQ
REDIS_CACHE_URL=redis://127.0.0.1:6379/0
REDIS_QUEUE_URL=redis://127.0.0.1:6379/1

# School Configuration
SCHOOL_TIMEZONE=Asia/Karachi
